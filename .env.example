# Copy this file to .env and fill in what you use. Git ignores .env, so your keys stay on this computer.

# Deepgram API key for live transcription. `npm start` fills it in and switches transcription to Deepgram, so you do not
# paste it into Settings every session. Only the Roomside page on this computer can read it, and `npm run build` never
# includes it.
DEEPGRAM_API_KEY=

# Files added to "Your context" every time Roomside opens, comma-separated, relative to this folder or absolute (PDF, Word
# .docx, text, or Markdown). Leave it empty to use the résumé files in this folder (any name containing "resume").
CONTEXT_FILES=
