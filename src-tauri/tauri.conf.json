{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roomside",
  "version": "0.1.0",
  "identifier": "app.roomside.interviewcopilot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Roomside · Interview Copilot",
        "width": 1320,
        "height": 900,
        "minWidth": 860,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Interview practice copilot",
    "longDescription": "A memory-only interview practice copilot that listens only after you explicitly start a session.",
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
