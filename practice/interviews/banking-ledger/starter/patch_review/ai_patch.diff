diff --git a/ledger/money.py b/ledger/money.py
--- a/ledger/money.py
+++ b/ledger/money.py
@@ -8,7 +8,9 @@ class InvalidAmount(ValueError):
 def parse_amount(text: str) -> int:
     """Converts a dollar amount such as "12.34" to integer cents."""
     try:
-        return int(float(text) * 100)
+        # float("19.99") * 100 is 1998.9999999999998, so round to the nearest cent
+        # instead of truncating.
+        return int(round(float(text) * 100))
     except (TypeError, ValueError, OverflowError) as error:
         raise InvalidAmount(f"invalid amount: {text!r}") from error
 
